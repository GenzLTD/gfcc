# ============================================================
# gfcc 环境配置模板 — 复制为 .env 后按需修改
#   cp .env.example .env
# ============================================================

# ---------- 安全 ----------
# HMAC 严格模式密钥（ethos 统一鉴权：Tatha / DemoPeter / am-gateway 三端同一把）。
# 留空 = stub 联调模式（不鉴权，仅本地开发）；生产务必填入强随机值。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
ETHOS_AUTH_SECRET=

# ---------- 对外端口（宿主机侧） ----------
TATHA_PORT=5210
DEMOPETER_PORT=5220
AM_GATEWAY_PORT=3210
GFCC_KERNEL_PORT=5211

# ---------- 格契内核 gfcc_kernel（五槽装配） ----------
# llm 槽：stub（默认，不接模型，关键词规则兜底）或 ollama（本地语义意图分类）
LLM_PROVIDER=stub
OLLAMA_MODEL=qwen2.5:7b
# 注意：kernel 是宿主机进程，直连本机 Ollama → localhost；
# 上面 Tatha/DemoPeter 那条 OLLAMA_BASE_URL 是 docker 容器视角 → host.docker.internal，两者语义不同，勿混用。
OLLAMA_BASE_URL=http://localhost:11434
# store 槽：stub（默认，内存实现，重启即空=「空数据合法」）或 sqlite（持久化）
STORE_PROVIDER=stub
STORE_DB_PATH=data/memory.db
# consensus 通过阈值（score >= threshold 才进入 awaiting_ack）
CONSENSUS_THRESHOLD=85

# ---------- LLM（Tatha 与 DemoPeter 共用） ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Tatha 意图模型：deepseek/deepseek-chat（云端）或 ollama/qwen2.5-coder:1.5b（本地）
TATHA_DEFAULT_MODEL=deepseek/deepseek-chat
# 本地 Ollama（可选，用于 DemoPeter embedding / Tatha 本地兜底）
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---------- agentmemory 引擎（黑盒镜像，钉死版本，勿随意升级） ----------
AGENTMEMORY_III_VERSION=0.11.2

# ---------- RAG 向量集合名 ----------
CHROMA_COLLECTION=gfcc_index
