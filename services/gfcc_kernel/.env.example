# 格契内核环境配置
# 留空 ETHOS_AUTH_SECRET = stub 联调（与现有 5210 基线一致）

# --- 服务 ---
HOST=0.0.0.0
PORT=5211

# --- ethos（同一把密钥）---
# 配置后启用 HS256 严格模式；留空 = StubVerifier 本地联调
ETHOS_AUTH_SECRET=
ETHOS_AUDIT_DB=logs/audit.db
# ETHOS_AUDIT_JSONL=logs/audit.jsonl

# --- 端口参数 ---
CONSENSUS_THRESHOLD=85

# --- llm 槽（stub 默认；接入厂商时填）---
LLM_MODEL=providers/default
# LLM_ENDPOINT=http://localhost:11434
