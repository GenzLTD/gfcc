# 格契内核环境配置
# 留空 ETHOS_AUTH_SECRET = stub 联调（与现有 5210 基线一致）

# --- 服务 ---
HOST=0.0.0.0
PORT=5211

# --- ethos（同一把密钥）---
# 配置后启用 HS256 严格模式；留空 = StubVerifier 本地联调
ETHOS_AUTH_SECRET=
ETHOS_AUDIT_DB=logs/audit.db
# ETHOS_AUDIT_JSONL=logs/audit.jsonl

# --- 信号链验签（与 Looma THOMAS .env 同一把，G1 本机联调冻结值）---
# 未带 X-Signature → 401 invalid_signature；signal_log 有 UNIQUE 幂等
SIGNAL_INGEST_SECRET=

# --- 端口参数 ---
CONSENSUS_THRESHOLD=85

# --- llm 槽（stub 默认；接入 Ollama 时设 LLM_PROVIDER=ollama）---
LLM_PROVIDER=stub             # stub | ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b  # 本机实际模型（文档默认 qwen2.5:7b 未拉）
# LLM_MODEL=providers/default   # 仅 stub 模式使用
# LLM_ENDPOINT=

# --- store 槽（stub 默认；SQLite 持久化时设 STORE_PROVIDER=sqlite）---
STORE_PROVIDER=stub           # stub | sqlite
STORE_DB_PATH=data/memory.db

# --- G6 会务态落库（圈/共识/地板；默认跟随 STORE_PROVIDER）---
# 独立库 data/circle_flow.db（CIRCLE_FLOW_DB 可覆盖，测试用临时路径），不进 Dual/邀请库
CIRCLE_FLOW_PROVIDER=         # 空 = 跟随 STORE_PROVIDER；stub=纯内存；sqlite=落盘
CIRCLE_FLOW_DB=               # 默认 data/circle_flow.db
