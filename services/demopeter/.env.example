# szpeter2026 知识库 - 环境配置模板
# 复制此文件为 .env 并填入实际值

# === AI 模型配置 ===
# DeepSeek API（推荐）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Ollama 本地模型（备选，需先安装 Ollama）
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2:latest

# 选择使用的 AI 提供商：deepseek 或 ollama
AI_PROVIDER=deepseek

# === 向量数据库配置（Docker 容器化）===
# Mac 本地开发推荐 persistent；生产 Docker 用 remote
CHROMA_MODE=persistent
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=szpeter2026_kb

# === 检索模式 ===
# hybrid: 向量 + FTS5 RRF 融合（推荐）| vector | keyword
SEARCH_MODE=hybrid
HYBRID_RRF_K=60

# === 融合测试语料（Projects 目录）===
USE_FUSED_CORPUS=true
# Windows 示例: PROJECTS_ROOT=D:/
PROJECTS_ROOT=/Users/jason/Projects
# 单目录语料（USE_FUSED_CORPUS=false 时使用）
# DEFAULT_CORPUS_DIR=/Users/jason/Projects/300662科锐国际

# === pgvector 向量数据库配置（可选备选方案）===
# 注意：pgvector 依赖本地 Ollama 运行 + nomic-embed-text 模型
# 若无 Ollama 服务，务必设为 false，避免每次启动尝试连接浪费时间
PGVECTOR_ENABLED=false
PGVECTOR_HOST=localhost
PGVECTOR_PORT=5432
PGVECTOR_USER=szpeter
PGVECTOR_PASSWORD=Szpeter2026!
PGVECTOR_DATABASE=szpeter2026
PGVECTOR_EMBEDDING_DIM=768

# === Ollama Embedding 模型（pgvector 向量化用）===
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# === 数据库配置 ===
# SQLite 元数据库（默认，无需配置）

# === Web 面板配置 ===
WEB_HOST=127.0.0.1
WEB_PORT=5200
WEB_DEBUG=false

# === 文档处理配置 ===
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# === Notion 集成（可选） ===
# NOTION_TOKEN=ntn_your_integration_secret
# NOTION_DATABASE_ID=your_database_id

# === Gitea Webhook（可选） ===
# GITEA_WEBHOOK_SECRET=your_webhook_secret
# GITEA_BASE_URL=http://your-gitea-server:3000

# === Outlook / Microsoft Graph OAuth2（可选） ===
# OUTLOOK_CLIENT_ID=your_azure_client_id
# OUTLOOK_CLIENT_SECRET=your_azure_client_secret
# OUTLOOK_REDIRECT_URI=http://localhost:5200/auth/outlook/callback
